<?php

/**
 * Implements hook_form_alter().
 */
function wudo_theme_extension_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form['#attached']['library'][] = 'wudo_theme_extension/paragraph_behavior';
}

/**
 * Implements hook_xmlsitemap_link_alter().
 *
 * Keeps the error pages out of the sitemap, as well as the front page node,
 * which the sitemap already lists as the site root.
 */
function wudo_theme_extension_xmlsitemap_link_alter(array &$link, array $context) {
  $pages = \Drupal::config('system.site')->get('page');
  $alias_manager = \Drupal::service('path_alias.manager');
  foreach (array_filter($pages) as $path) {
    if ($alias_manager->getPathByAlias($path) === $link['loc']) {
      $link['access'] = FALSE;
    }
  }
}
