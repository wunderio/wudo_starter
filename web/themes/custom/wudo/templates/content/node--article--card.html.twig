{% embed 'wudo:article-card' with {
  variant: 'mini-horizontal',
  title: label,
  title_url: url,
  summary: content.field_body|default(''),
  with_image: node.field_image is defined and not node.field_image.isEmpty(),
} %}
  {% block image %}
    {{ content.field_image }}
  {% endblock %}
{% endembed %}