<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\csp\Csp;
use Symfony\Component\HttpFoundation\Response;

/**
 * @file
 * Page related functions to support theming.
 */

/**
 * Builds the import map that lets components import Lit by its bare name.
 *
 * Generated rather than read from a file so that it follows the theme's
 * location, e.g. when Drupal is installed in a subdirectory.
 */
function wudo_import_map(): string {
  $bundle = base_path() . \Drupal::service('extension.list.theme')->getPath('wudo') . '/dist/lit-core.bundle.js';

  return json_encode([
    'imports' => [
      'lit' => $bundle,
      'lit/directives/unsafe-html.js' => $bundle,
    ],
  ], JSON_UNESCAPED_SLASHES);
}

/**
 * Implements hook_page_attachments_alter().
 */
function wudo_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => ['type' => 'importmap'],
      '#value' => wudo_import_map(),
    ],
    'wudo_importmap_inline',
  ];
}

/**
 * Implements hook_csp_policy_alter().
 *
 * Allows the inline import map by its hash, so that the Content Security
 * Policy does not need to allow inline scripts in general.
 */
function wudo_csp_policy_alter(Csp $policy, Response $response): void {
  \Drupal::service('csp.policy_helper')->appendHash(
    $policy,
    'script',
    'elem',
    [Csp::POLICY_UNSAFE_INLINE],
    Csp::calculateHash(wudo_import_map()),
  );
}

/**
 * Adds Wudo theme settings to the page template.
 */
function wudo_preprocess_page(array &$variables) {
  $variables['copyright'] = theme_get_setting('copyright', 'wudo');
  $variables['use_scroll_to_top'] = (bool) theme_get_setting('use_scroll_to_top', 'wudo');
}

/**
 * Adds custom settings to the Wudo theme settings form.
 */
function wudo_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state) {
  $form['wudo_page'] = [
    '#type' => 'details',
    '#title' => t('Page'),
    '#open' => TRUE,
  ];
  $form['wudo_page']['use_scroll_to_top'] = [
    '#type' => 'checkbox',
    '#title' => t('Use scroll to top'),
    '#default_value' => (bool) theme_get_setting('use_scroll_to_top', 'wudo'),
  ];

  $form['wudo_footer'] = [
    '#type' => 'details',
    '#title' => t('Footer'),
    '#open' => TRUE,
  ];
  $form['wudo_footer']['copyright'] = [
    '#type' => 'textfield',
    '#title' => t('Copyright text'),
    '#description' => t('Text displayed in the Footer bottom region.'),
    '#default_value' => theme_get_setting('copyright', 'wudo') ?: 'Copyright © ' . date('Y'),
    '#maxlength' => 255,
  ];
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function wudo_theme_suggestions_page_alter(array &$suggestions, array $variables) {
    if ($node = \Drupal::routeMatch()->getParameter('node')) {
        // Add content type suggestions.
        $suggestions[] = 'page__node__' . $node->bundle();
    }
}

/**
 * Implements hook_preprocess_links__language_block().
 */
function wudo_preprocess_links__language_block(&$variables) {
  $language_manager = \Drupal::languageManager();
  $current_lang_id = $language_manager->getCurrentLanguage()->getId();
  $lang_items = [];

  foreach ($variables['links'] as $lang_code => $item) {
    if (isset($item['link']['#url'])) {
      /** @var \Drupal\Core\Url $url */
      $url = $item['link']['#url'];

      $url->setOption('language', $language_manager->getLanguage($lang_code));
      $url_string = $url->toString();

      $lang_items[] = [
        'code'       => $lang_code,
        'text'       => $item['text'],
        'url'        => $url_string,
        'is_active'  => ($lang_code === $current_lang_id),
        'attributes' => $item['attributes'],
      ];
    }
  }

  $variables['custom_languages'] = $lang_items;
}
