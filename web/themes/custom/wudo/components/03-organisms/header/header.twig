{% set utils %}
  {% block utilities %}{% endblock %}
{% endset %}

{% set branding %}
  {% block branding %}{% endblock %}
{% endset %}

{% set nav %}
  {% block navigation %}{% endblock %}
{% endset %}

{% set header_utils %}
  {% block header_utils %}{% endblock %}
{% endset %}

{% set utils_output = utils|render|trim %}
{% set branding_output = branding|render|trim %}
{% set nav_output = nav|render|trim %}
{% set header_utils = header_utils|render|trim %}

<header {{ attributes.addClass('site-header') }}>
  {% if utils_output is not empty %}
    <div class="site-header__utils">
      <div class="page-wrapper">
        {{ utils_output|raw }}
      </div>
    </div>
  {% endif %}

  {% if branding_output is not empty or nav_output is not empty %}
    {% set header_content %}
      <div class="site-header__main">
        <div class="page-wrapper">
          <div class="site-header__main--content">
            {% if branding_output is not empty %}
              <div class="site-header__branding">
                {{ branding_output|raw }}
              </div>
            {% endif %}

            {% if nav_output is not empty %}
              {# On small screens the drawer below borrows the menu while it is open. #}
              <div class="site-header__menu" id="site-menu-wrapper">
                <div class="site-header__menu-content" id="site-menu">
                  {{ nav_output|raw }}
                </div>
              </div>
            {% endif %}

            {% if header_utils is not empty %}
              <div class="site-header__main-utils">
                {{ header_utils|raw }}
              </div>
            {% endif %}

            {% if nav_output is not empty %}
              {{ include('wudo:button', {
                text: 'Menu'|t,
                icon: 'menu',
                icon_only: true,
                icon_size: 'large',
                attributes: create_attribute({
                  'class': ['site-header__menu-button'],
                  'data-drawer-open': 'mobile-menu-drawer',
                  'aria-haspopup': 'dialog',
                }),
              }, with_context = false) }}
            {% endif %}
          </div>
        </div>
      </div>
    {% endset %}

    {# Sticky header #}
    {% if is_sticky %}
      {% embed 'wudo:sticky-header' with {
        threshold: sticky_threshold|default(150),
      } %}
        {% block content %}
          {{ header_content }}
        {% endblock %}
      {% endembed %}
    {% else %}
      {{ header_content }}
    {% endif %}

  {% endif %}
</header>

{# Outside the header: a sticky header moves with a transform, which would
   pin the fixed drawer to the header instead of the viewport. #}
{% if nav_output is not empty %}
  {{ include('wudo:drawer', {
    id: 'mobile-menu-drawer',
    position: 'right',
    size: '400px',
    title: 'Menu'|t,
    modifier_class: 'drawer--menu',
    content: '<div id="mobile-menu-slot"></div>',
    portal: {
      source: '#site-menu',
      wrapper: '#site-menu-wrapper',
      slot: 'mobile-menu-slot',
    },
  }, with_context = false) }}
{% endif %}
