{#
/**
 * @file
 * Social links component.
 *
 * Variables:
 * - items: [array] Links. Each item contains:
 *   - title: [string] Name of the network, read by screen readers.
 *   - url: [string|Drupal\Core\Url] Address of the profile.
 *   - icon: [string] Icon name. Defaults to a globe.
 */
#}

{% if items %}
  <ul class="social-links">
    {% for item in items %}
      {% set icon = item.icon|default('globe') %}
      <li class="social-links__item">
        <a class="social-links__link social-links__link--{{ icon }}" href="{{ item.url }}" rel="me">
          {{ include('wudo:icon', {
            symbol: icon,
            modifier_class: 'social-links__icon',
          }, with_context = false) }}
          <span class="visually-hidden">{{ item.title }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
